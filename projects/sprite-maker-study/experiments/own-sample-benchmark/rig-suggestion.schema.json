{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["morphology", "points", "bones", "frames", "reasoning"],
  "properties": {
    "morphology": {"type": "string", "enum": ["biped"]},
    "points": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "x", "y", "confidence", "note"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["joint", "anchor", "contact", "pivot"]},
          "x": {"type": "integer", "minimum": 0, "maximum": 159},
          "y": {"type": "integer", "minimum": 0, "maximum": 223},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "note": {"type": "string"}
        }
      }
    },
    "bones": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "start", "end", "radius", "parent", "z"],
        "properties": {
          "name": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "radius": {"type": "integer", "minimum": 1, "maximum": 40},
          "parent": {"type": ["string", "null"]},
          "z": {"type": "integer", "minimum": 0, "maximum": 20}
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "rootDx", "rootDy", "transforms", "contacts"],
        "properties": {
          "phase": {"type": "string"},
          "rootDx": {"type": "integer", "minimum": -4, "maximum": 4},
          "rootDy": {"type": "integer", "minimum": -4, "maximum": 4},
          "transforms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bone", "rotate", "dx", "dy", "scaleX", "scaleY"],
              "properties": {
                "bone": {"type": "string"},
                "rotate": {"type": "number", "minimum": -25, "maximum": 25},
                "dx": {"type": "integer", "minimum": -4, "maximum": 4},
                "dy": {"type": "integer", "minimum": -4, "maximum": 4},
                "scaleX": {"type": "number", "minimum": 0.9, "maximum": 1.1},
                "scaleY": {"type": "number", "minimum": 0.9, "maximum": 1.1}
              }
            }
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bone", "x", "y", "bend"],
              "properties": {
                "bone": {"type": "string"},
                "x": {"type": "integer", "minimum": 0, "maximum": 159},
                "y": {"type": "integer", "minimum": 0, "maximum": 223},
                "bend": {"type": "integer", "enum": [-1, 1]}
              }
            }
          }
        }
      }
    },
    "reasoning": {"type": "string"}
  }
}
